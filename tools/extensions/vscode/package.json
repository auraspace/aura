{
  "name": "aura-language-support",
  "displayName": "Aura Language Support",
  "description": "Language support for the Aura programming language.",
  "version": "0.1.1-alpha.1",
  "publisher": "auraspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/auraspace/aura"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "aura",
    "language server",
    "lsp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:aura",
    "onCommand:aura.restartLanguageServer",
    "onCommand:aura.selectToolchain",
    "onCommand:aura.checkProject",
    "onCommand:aura.buildProject",
    "onCommand:aura.testProject",
    "onCommand:aura.raceProject",
    "onCommand:aura.formatProject",
    "onCommand:aura.showOutput"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aura",
        "aliases": [
          "Aura",
          "aura"
        ],
        "extensions": [
          ".aura"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/aura-language-light.svg",
          "dark": "./assets/aura-language-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "aura",
        "scopeName": "source.aura",
        "path": "./syntaxes/aura.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Aura",
      "properties": {
        "aura.serverPath": {
          "type": "string",
          "default": "aura",
          "description": "Path to the Aura CLI executable. The CLI must provide the `language-server` command."
        },
        "aura.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "language-server"
          ],
          "description": "Arguments passed to the Aura language server executable."
        },
        "aura.cliPath": {
          "type": "string",
          "default": "aura",
          "description": "Path to the Aura CLI used by project commands such as Check, Build, Test, Race, and Format."
        },
        "aura.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Disable LSP protocol tracing.",
            "Trace LSP messages without payload details.",
            "Trace full LSP messages for diagnostics."
          ],
          "default": "off",
          "description": "Protocol tracing level for the Aura language server."
        }
      }
    },
    "commands": [
      {
        "command": "aura.restartLanguageServer",
        "title": "Aura: Restart Language Server"
      },
      {
        "command": "aura.selectToolchain",
        "title": "Aura: Select Toolchain"
      },
      {
        "command": "aura.checkProject",
        "title": "Aura: Check Project"
      },
      {
        "command": "aura.buildProject",
        "title": "Aura: Build Project"
      },
      {
        "command": "aura.testProject",
        "title": "Aura: Test Project"
      },
      {
        "command": "aura.raceProject",
        "title": "Aura: Race Tests"
      },
      {
        "command": "aura.formatProject",
        "title": "Aura: Format Project"
      },
      {
        "command": "aura.showOutput",
        "title": "Aura: Show Language Server Output"
      }
    ]
  },
  "scripts": {
    "bundle": "node scripts/build-extension.mjs",
    "compile": "tsc -p ./tsconfig.json && npm run bundle",
    "watch": "node scripts/build-extension.mjs --watch",
    "check": "tsc -p ./tsconfig.json --noEmit",
    "test": "npm run compile && node test/manifest.test.mjs",
    "stage-server": "node scripts/stage-server.mjs",
    "package": "npm run stage-server && npm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "icon": "icon.png"
}
