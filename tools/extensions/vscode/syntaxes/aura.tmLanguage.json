{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aura",
  "scopeName": "source.aura",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#custom-types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aura",
          "begin": "//",
          "end": "$",
          "patterns": [{ "include": "#comment-tasks" }]
        },
        {
          "name": "comment.block.aura",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "comment-tasks": {
      "patterns": [
        {
          "name": "keyword.other.todo.aura",
          "match": "\\b(?:TODO|FIXME|NOTE|HACK)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.aura",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.aura", "match": "\\\\[ntr\\\"]" }
      ]
    },
    "attributes": {
      "name": "entity.other.attribute-name.aura",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "name": "keyword.control.aura",
      "match": "\\b(?:abstract|as|async|await|break|cancel|case|catch|class|companion|const|continue|else|enum|extern|false|final|finally|for|fun|if|import|in|interface|is|join|match|null|object|open|override|package|private|protected|pub|return|spawn|struct|this|throw|true|try|type|val|var|vararg|where|while)\\b"
    },
    "constants": {
      "name": "constant.language.aura",
      "match": "\\b(?:true|false|null|this)\\b"
    },
    "types": {
      "name": "support.type.aura",
      "match": "\\b(?:Any|Array|Bool|Byte|Channel|Char|Error|ErrorKind|Float|ForeignHandle|HashMap|HashMapEntry|HashSet|Int|Long|Never|Option|Outcome|Result|String|Task|TaskHandle|UInt|ULong|Unit)\\b"
    },
    "custom-types": {
      "name": "entity.name.type.aura",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "numbers": {
      "name": "constant.numeric.integer.decimal.aura",
      "match": "\\b[0-9]+\\b"
    },
    "operators": {
      "name": "keyword.operator.aura",
      "match": "\\?\\.|\\?:|\\.\\.=|\\.\\.|!!|=>|->|==|!=|<=|>=|&&|\\|\\||[+*/%!=<>?:.&|-]"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|enum|interface|struct|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aura" },
            "2": { "name": "entity.name.type.aura" }
          }
        },
        {
          "match": "\\b(const|val|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aura" },
            "2": { "name": "variable.other.definition.aura" }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.aura" },
            "2": { "name": "entity.name.function.aura" }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_])(?!if\\b|while\\b|for\\b|catch\\b|match\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.aura" }
          }
        }
      ]
    }
  }
}
