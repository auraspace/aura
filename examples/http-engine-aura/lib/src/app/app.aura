package aura.web

import std.http
import std.net

pub class App(private val routerValue: Router) {
    pub fun use(handler: (Context) -> Task<Unit>): App {
        this.routerValue.use(handler)
        return this
    }

    pub fun get(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.get(path, handler)
        return this
    }

    pub fun post(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.post(path, handler)
        return this
    }

    pub fun put(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.put(path, handler)
        return this
    }

    pub fun patch(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.patch(path, handler)
        return this
    }

    pub fun delete(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.delete(path, handler)
        return this
    }

    pub fun options(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.options(path, handler)
        return this
    }

    pub fun all(path: String, handler: (Context) -> Task<Unit>): App {
        this.routerValue.all(path, handler)
        return this
    }

    pub fun group(prefix: String): Group {
        return Group(this, prefix)
    }

    async fun dispatch(request: Request, response: Response): Unit {
        await this.routerValue.dispatch(request, response)
    }

    pub fun listen(port: Int): Unit {
        val listener = listen(port.toString())
        serve(listener, makeHandler(this))
    }
}

fun makeHandler(app: App): (Request, Response) -> Task<Unit> {
    return (request: Request, response: Response) => app.dispatch(request, response)
}

pub fun webApp(maxBytes: Int = 1048576): App {
    return App(router(maxBytes))
}
