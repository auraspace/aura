package aura.web

// Group is a small plugin-like facade for mounting a set of routes under a
// shared prefix, similar to Express.Router or Fastify.register.
pub class Group(private val app: App, private val prefix: String) {
    pub fun get(path: String, handler: (Context) -> Task<Unit>): Group {
        this.app.get(joinPath(this.prefix, path), handler)
        return this
    }

    pub fun post(path: String, handler: (Context) -> Task<Unit>): Group {
        this.app.post(joinPath(this.prefix, path), handler)
        return this
    }

    pub fun put(path: String, handler: (Context) -> Task<Unit>): Group {
        this.app.put(joinPath(this.prefix, path), handler)
        return this
    }

    pub fun delete(path: String, handler: (Context) -> Task<Unit>): Group {
        this.app.delete(joinPath(this.prefix, path), handler)
        return this
    }
}

fun joinPath(prefix: String, path: String): String {
    if (prefix.endsWith("/") && path.startsWith("/")) {
        return prefix.substring(0, prefix.len - 1) + path
    }
    if (!prefix.endsWith("/") && !path.startsWith("/")) {
        return prefix + "/" + path
    }
    return prefix + path
}
