package aura.web

import std.http

pub class Router(private val routes: Array<Route>, private val middlewares: Array<Middleware>,
                 private val mounted: Array<MountedMiddleware>, private val bodyLimit: Int,
                 private val matcher: RouteMatcher,
                 private var errorHandler: ErrorHandler,
                 private var hasErrorHandler: Bool,
                 private val nextMiddlewares: Array<Middleware>,
                 private val onRequestHandlers: Array<Middleware>,
                 private val preHandlerHandlers: Array<Middleware>,
                 private val onSendHandlers: Array<Middleware>,
                 private val onResponseHandlers: Array<Middleware>) {
    constructor(bodyLimit: Int = 1048576): this(
        Array<Route>(0), Array<Middleware>(0), Array<MountedMiddleware>(0),
        bodyLimit, DefaultRouteMatcher(),
        (error: String, context: Context) => emptyErrorHandler(error, context),
        false,
        Array<Middleware>(0),
        Array<Middleware>(0),
        Array<Middleware>(0), Array<Middleware>(0), Array<Middleware>(0)
    ) {}

    pub fun use(vararg handlers: WebHandler): Router {
        for (i in 0..handlers.len) {
            this.middlewares.push(Middleware(handlers.get(i)))
        }
        return this
    }

    pub fun use(path: String, vararg handlers: WebHandler): Router {
        for (i in 0..handlers.len) {
            this.mounted.push(MountedMiddleware(path, Middleware(handlers.get(i))))
        }
        return this
    }

    pub fun useNext(vararg handlers: NextHandler): Router {
        for (i in 0..handlers.len) {
            this.nextMiddlewares.push(Middleware(handlers.get(i)))
        }
        return this
    }

    pub fun onError(handler: ErrorHandler): Router {
        errorHandler = handler
        hasErrorHandler = true
        return this
    }

    pub fun onRequest(handler: WebHandler): Router {
        this.onRequestHandlers.push(Middleware(handler))
        return this
    }

    pub fun preHandler(handler: WebHandler): Router {
        this.preHandlerHandlers.push(Middleware(handler))
        return this
    }

    pub fun onSend(handler: WebHandler): Router {
        this.onSendHandlers.push(Middleware(handler))
        return this
    }

    pub fun onResponse(handler: WebHandler): Router {
        this.onResponseHandlers.push(Middleware(handler))
        return this
    }

    pub fun addRoute(method: String, path: String,
                     routeMiddlewares: Array<Middleware>,
                     controller: WebHandler): Router {
        this.routes.push(Route(method, path, routeMiddlewares, controller))
        return this
    }

    pub fun get(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) {
            routeMiddlewares.push(Middleware(handlers.get(i)))
        }
        return this.addRoute("GET", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    pub fun post(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) { routeMiddlewares.push(Middleware(handlers.get(i))) }
        return this.addRoute("POST", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    pub fun put(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) { routeMiddlewares.push(Middleware(handlers.get(i))) }
        return this.addRoute("PUT", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    pub fun patch(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) { routeMiddlewares.push(Middleware(handlers.get(i))) }
        return this.addRoute("PATCH", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    pub fun delete(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) { routeMiddlewares.push(Middleware(handlers.get(i))) }
        return this.addRoute("DELETE", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    pub fun options(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) { routeMiddlewares.push(Middleware(handlers.get(i))) }
        return this.addRoute("OPTIONS", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    pub fun all(path: String, vararg handlers: WebHandler): Router {
        if (handlers.len == 0) { throw "route requires a controller" }
        val routeMiddlewares = Array<Middleware>(0)
        for (i in 0..handlers.len - 1) { routeMiddlewares.push(Middleware(handlers.get(i))) }
        return this.addRoute("*", path, routeMiddlewares, handlers.get(handlers.len - 1))
    }

    fun methodMatches(routeMethod: String, requestMethod: String): Bool {
        return routeMethod == "*" || routeMethod == requestMethod ||
               (requestMethod == "HEAD" && routeMethod == "GET")
    }

    async fun dispatch(request: Request, response: Response): Unit {
        val context = Context.empty(request, response, Array<Param>(0), this.bodyLimit)
        try {
            for (i in 0..this.onRequestHandlers.len) {
                val requestHandler = this.onRequestHandlers.get(i)
                await invokeMiddleware(requestHandler, context)
            }
            for (i in 0..this.middlewares.len) {
                val middleware = this.middlewares.get(i)
                await invokeMiddleware(middleware, context)
            }
            var pathMatched = false
            for (i in 0..this.routes.len) {
                val route = this.routes.get(i)
                val path = this.matcher.matches(route.path, request.target())
                if (path.matched) {
                    pathMatched = true
                    if (this.methodMatches(route.method, request.method())) {
                        val matchedContext = Context(request, response, path.params, this.bodyLimit)
                        for (j in 0..this.nextMiddlewares.len) {
                            val nextMiddleware = this.nextMiddlewares.get(j)
                            val continuation = Next(0)
                            await nextMiddleware.nextHandler(matchedContext, continuation)
                            if (continuation.decision == 2) {
                                return
                            }
                        }
                        for (j in 0..this.mounted.len) {
                            val mountedEntry = this.mounted.get(j)
                            if (pathPrefixMatches(mountedEntry.path, request.target())) {
                                await invokeMiddleware(mountedEntry.middleware, matchedContext)
                            }
                        }
                        for (j in 0..route.middlewares.len) {
                            val routeMiddleware = route.middlewares.get(j)
                            await invokeMiddleware(routeMiddleware, matchedContext)
                        }
                        if (this.preHandlerHandlers.len > 0) {
                            for (j in 0..this.preHandlerHandlers.len) {
                                val preHandler = this.preHandlerHandlers.get(j)
                                await invokeMiddleware(preHandler, matchedContext)
                            }
                        }
                        await route.handler(matchedContext)
                        if (this.onSendHandlers.len > 0) {
                            for (j in 0..this.onSendHandlers.len) {
                                val sendHandler = this.onSendHandlers.get(j)
                                await invokeMiddleware(sendHandler, matchedContext)
                            }
                        }
                        if (this.onResponseHandlers.len > 0) {
                            for (j in 0..this.onResponseHandlers.len) {
                                val responseHandler = this.onResponseHandlers.get(j)
                                await invokeMiddleware(responseHandler, matchedContext)
                            }
                        }
                        return
                    }
                }
            }

            if (pathMatched) {
                response.setStatus(405)
                response.setBody("method not allowed\n")
            } else {
                response.setStatus(404)
                response.setBody("not found\n")
            }
        } catch (error: String) {
            if (this.hasErrorHandler) {
                val errorContext = Context.empty(request, response, Array<Param>(0), this.bodyLimit)
                val handler = this.errorHandler
                await handler(error, errorContext)
                return
            }
            if (error == "request body exceeds configured limit") {
                response.setStatus(413)
                response.addHeader("Content-Type", "application/json")
                response.setBody("{\"error\":\"payload_too_large\"}")
                return
            }
            throw error
        }
    }
}

pub class MountedMiddleware(pub val path: String, pub val middleware: Middleware) {}

fun pathPrefixMatches(prefix: String, target: String): Bool {
    var targetPath = target
    val queryStart = targetPath.indexOf("?")
    if (queryStart >= 0) {
        targetPath = targetPath.substring(0, queryStart)
    }
    if (prefix == "/" || prefix == "") {
        return true
    }
    if (targetPath == prefix) {
        return true
    }
    return targetPath.startsWith(prefix + "/")
}

/// Configure the maximum aggregated request body accepted by Context helpers.
pub fun router(maxBytes: Int = 1048576): Router {
    return Router(maxBytes)
}
