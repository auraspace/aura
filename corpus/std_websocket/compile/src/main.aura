package demo.stdwebsocket.compile

import std.io as Io
import std.websocket as Ws

async fun probe() {
  try {
    val connection = await Ws.connect("ws://127.0.0.1:1")
    await connection.send(Ws.text("hello"))
    await connection.ping("heartbeat")
    val message = await connection.receive()
    connection.close()
  } catch (error: String) {
    Io.println("websocket boundary ok")
  }
}

fun main() {
  val task = spawn {
    await probe()
    return
  }
  val outcome: Io.Result<Unit, Io.TaskError> = join(task)
}
