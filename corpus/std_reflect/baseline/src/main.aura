package demo.stdreflect

import std.reflect

@reflect
class Widget(pub val count: Int, pub val label: String, private val secret: Int) {
  pub fun reset(): Unit {}
}

@reflect
class Box<T>(pub val value: T) {
  pub fun get(): T { return this.value }
}

class Hidden(val value: Int) {}

@reflect
struct Point(pub val x: Int) {}

@reflect
enum Shade { case Light case Dark }

@reflect
interface Named { fun name(): String }

@reflect
interface Sized<T> { fun get(): T }

fun main() {
    val intType = typeOf<Int>()
    val stringType = typeOf<String>()
    val widgetType = typeOf<Widget>()
    val boxType = typeOf<Box<Int>>()
    val sizedType = typeOf<Sized<Int>>()
    val intId = typeIdOf<Int>()
    if (intType.name() != "Int" || stringType.name() != "String") { throw "bad type name" }
    if (intId.value != "Int") { throw "bad type id" }
    if (boxType.name() != "demo_stdreflect_Box_Int") { throw "bad generic type name" }
    val info = typeInfo("Int")
    if (info.name != "Int") { throw "bad type info" }
    if (!isReflectable("String") || !isReflectable("Widget")) { throw "bad reflectability" }
    if (isReflectable("Hidden")) { throw "unannotated type reflected" }
    if (!isReflectable("Point") || !isReflectable("Shade") || !isReflectable("Named")) { throw "missing reflected type" }
    if (!isReflectable("demo_stdreflect_Sized_Int") || sizedType.methods().len != 1) { throw "missing generic interface metadata" }
    if (fields("Int").len != 0 || methods("Int").len != 0) { throw "bad members" }
    if (fields("Widget").len != 2 || methods("Widget").len != 1) { throw "missing metadata" }
    if (fields("demo_stdreflect_Box_Int").len != 1 || methods("demo_stdreflect_Box_Int").len != 1) { throw "missing generic metadata" }
    if (fields("Widget").get(0) != "count" || methods("Widget").get(0) != "reset") { throw "bad metadata" }
    if (fields("Point").len != 1 || methods("Named").len != 1) { throw "missing reflected members" }
    if (widgetType.fields().len != 2 || widgetType.methods().len != 1) { throw "bad type metadata" }
    if (widgetType.fields().get(0).typeName != "Int" || widgetType.methods().get(0).returnType != "Unit") { throw "bad member types" }
    if (!isReflectable("demo_stdreflect_Box_Int") || boxType.fields().get(0).typeName != "Int" || boxType.methods().get(0).returnType != "Int") { throw "bad generic member types" }
    if (methods("demo_stdreflect_Sized_Int").len != 1 || sizedType.methods().get(0).returnType != "Int") { throw "bad generic interface member types" }
    if (typeOf<Hidden>().fields().len != 0) { throw "hidden metadata leaked" }
    println("reflect-ok")
}
