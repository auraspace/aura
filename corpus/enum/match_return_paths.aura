// Match branches return values while carrying different payload shapes.
package demo.match_return

enum Command {
    case Stop
    case Add(value: Int)
    case Pair(left: Int, right: Int)
}

fun score(command: Command): Int {
    match (command) {
        case Stop => {
            return 0
        }
        case Add(value) => {
            return value
        }
        case Pair(left, right) => {
            return left + right
        }
    }
}

fun main() {
    assert_eq(score(Stop()), 0)
    assert_eq(score(Add(4)), 4)
    assert_eq(score(Pair(2, 5)), 7)
    println("match-return-ok")
}
