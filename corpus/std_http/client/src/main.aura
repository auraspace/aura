package demo.stdhttp.client

import std.http

async fun fetch(endpoint: String): Unit {
  val response: ClientResponse = await getResponse(endpoint, "/health")
  println(response.status.toString())
  println(response.body)
}

fun main() {
  val values = args()
  if (values.len < 2) {
    exit(2)
  }
  fetch(values.get(1))
}
