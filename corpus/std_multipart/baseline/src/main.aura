package demo.stdmultipart

import std.multipart

fun main() {
  val parts: Array<Part> = Array<Part>(0)
  parts.push(Part("name", "", "text/plain", "Aura"))
  parts.push(Part("file", "a.txt", "text/plain", "hello"))
  parts.push(Part("quoted\"name", "a\\b.txt", "text/plain", "x--BOUNDARYy"))
  val body = encode(parts, "BOUNDARY")
  val parsed = parser("BOUNDARY").parse(body)
  if (parsed.len != 3) { throw "bad multipart count" }
  if (parsed.get(0).name != "name" || parsed.get(0).body != "Aura") { throw "bad field" }
  if (parsed.get(1).filename != "a.txt" || parsed.get(1).contentType != "text/plain") { throw "bad file" }
  if (parsed.get(2).name != "quoted\"name" || parsed.get(2).filename != "a\\b.txt" || parsed.get(2).body != "x--BOUNDARYy") { throw "bad quoted field" }
  if (parser("").parse(body).len != 0) { throw "bad empty boundary" }
  if (encode(parts, "bad\r\nboundary") != "") { throw "unsafe boundary accepted" }
  val unsafe = Array<Part>(0)
  unsafe.push(Part("name\r\ninjected", "", "text/plain", "body"))
  if (encode(unsafe, "BOUNDARY") != "") { throw "header injection accepted" }
  println("multipart-ok")
}
