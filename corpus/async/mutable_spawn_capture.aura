// RUNTIME-002: mutable captures share storage with a scheduled task frame.
package demo.mutable_spawn_capture

class Box(var value: Int) {}

fun report(number: Int, box: Box) {
  println(number.toString())
  println(box.value.toString())
}

fun main() {
  var number: Int = 1
  var box: Box = Box(1)
  val task = spawn {
    report(number, box)
    return
  }
  number = 2
  box = Box(2)
  join(task)
}
