package demo.stdnet.typed

import std.error as Errs
import std.net

async fun inspect(stream: ForeignHandle<Int>): Unit {
  val result: Errs.Outcome<String, Errs.Error> =
    await readStreamResult(stream, 32)
  if (Errs.isSuccess(result)) {
    println("read-ok")
  } else {
    println("read-error")
  }
}

fun main() {}
