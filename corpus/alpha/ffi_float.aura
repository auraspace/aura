// Float crosses the foreign declaration boundary as C double.
package demo.ffi_float

@foreign(library = "m", target = "native", link = "dynamic", abi = 1, abi_id = "c")
extern "C" fun sqrt(value: Float): Float

fun main() {
    val value: Float = sqrt(4.0)
    if (value == 2.0) { println("ffi-float") }
}
