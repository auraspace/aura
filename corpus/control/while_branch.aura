// While loop with a false initial condition and a later true condition.
package demo.while_branch

fun count(limit: Int): Int {
    var current: Int = 0
    var total: Int = 0
    while (current < limit) {
        total = total + current
        current = current + 1
    }
    return total
}

fun main() {
    assert_eq(count(0), 0)
    assert_eq(count(4), 6)
    println("while")
}
