// std.fs -- bounded portable path helpers.

package std.fs

import std.error as FsErrs
import std.io as FsIo

/// Join `base` and `child` using the host path separator rules.
pub fun join(base: String, child: String): String { throw "fs intrinsic" }

/// Return the final non-separator component of `path`.
pub fun basename(path: String): String { throw "fs intrinsic" }

/// Return the directory portion of `path`.
pub fun dirname(path: String): String { throw "fs intrinsic" }

/// Return the final extension, or null when the basename has none.
pub fun extension(path: String): String? { throw "fs intrinsic" }

/// Return whether `path` is absolute under the host path rules.
pub fun isAbsolute(path: String): Bool { throw "fs intrinsic" }

/// Return whether `path` exists and names a directory.
pub fun isDirectory(path: String): Bool { throw "fs intrinsic" }

/// Create `path` and any missing parent directories. Returns false on invalid
/// paths or filesystem errors.
pub fun ensureDirectory(path: String): Bool { throw "fs intrinsic" }

/// Return a stable bounded mode: 0 missing/error, 1 regular file, 2
/// directory, 3 other filesystem node.
pub fun fileMode(path: String): Int { throw "fs intrinsic" }

/// Return the low nine POSIX permission bits, or 0 when metadata is absent.
pub fun permissions(path: String): Int { throw "fs intrinsic" }

/// Return the modification time as Unix epoch milliseconds, or -1 on error.
pub fun modifiedMillis(path: String): Int { throw "fs intrinsic" }

/// Return a bounded newline-delimited snapshot of directory entry names.
pub fun listNames(path: String): String { throw "fs intrinsic" }

/// Inspect the path itself (without following it) for a symbolic link.
pub fun isSymlink(path: String): Bool { throw "fs intrinsic" }

/// Read text through a shared error outcome instead of throwing.
pub fun readTextResult(path: String): FsErrs.Outcome<String, FsErrs.OsError> {
  val content = FsIo.tryReadFile(path)
  if (content == null) {
    return FsErrs.failure(FsErrs.asOsError(FsErrs.notFound("file read failed", 0)))
  }
  return FsErrs.success(content!!)
}

/// Write text through a shared error outcome instead of throwing.
pub fun writeTextResult(path: String, content: String): FsErrs.Outcome<Bool, FsErrs.OsError> {
  if (!FsIo.tryWriteFile(path, content)) {
    return FsErrs.failure(FsErrs.asOsError(FsErrs.invalidInput("file write failed", 0)))
  }
  return FsErrs.success(true)
}

/// Return file metadata through the package-owned error boundary. Mode zero
/// is reserved for a missing path or an unreadable metadata query.
pub fun fileModeResult(path: String): FsErrs.Outcome<Int, FsErrs.OsError> {
  val mode = fileMode(path)
  if (mode == 0) {
    return FsErrs.failure(FsErrs.asOsError(FsErrs.notFound("metadata lookup failed", 0)))
  }
  return FsErrs.success(mode)
}

/// Return directory names without exposing the runtime's nullable snapshot.
pub fun listNamesResult(path: String): FsErrs.Outcome<String, FsErrs.OsError> {
  val names = listNames(path)
  if (fileMode(path) != 2) {
    return FsErrs.failure(FsErrs.asOsError(FsErrs.notFound("directory listing failed", 0)))
  }
  return FsErrs.success(names)
}
