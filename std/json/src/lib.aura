// std.json -- bounded JSON validation and string escaping.

package std.json

import std.error as JsonErrs

/// Policy for duplicate object member names.
pub enum DuplicateKeyPolicy {
  case Reject
  case FirstWins
  case LastWins
}

/// Bounds and duplicate-key behavior for source-backed value parsing.
pub class ParseOptions(pub val maxBytes: Int,
                       pub val maxDepth: Int,
                       pub val duplicateKeys: DuplicateKeyPolicy) {}

/// RFC-007 typed JSON parsing failure contract.
pub enum ParseError {
  case JsonInvalidInput(offset: Int)
  case JsonLimitExceeded(limit: Int)
  case JsonDuplicateKey(key: String)
  case JsonTypeMismatch(expected: String)
}

pub fun parseOptions(maxBytes: Int,
                     maxDepth: Int,
                     duplicateKeys: DuplicateKeyPolicy): ParseOptions {
  return ParseOptions(maxBytes, maxDepth, duplicateKeys)
}

pub fun rejectDuplicateKeys(): DuplicateKeyPolicy {
  return Reject()
}

pub fun firstDuplicateKeyWins(): DuplicateKeyPolicy {
  return FirstWins()
}

pub fun lastDuplicateKeyWins(): DuplicateKeyPolicy {
  return LastWins()
}

// These helpers stay package-private; the C backend replaces them with
// bounded span operations over the validated JSON source.
fun jsonObjectGet(value: String, key: String): String? { throw "json object lookup intrinsic" }
fun jsonArrayAt(value: String, index: Int): String? { throw "json array lookup intrinsic" }
fun jsonObjectKeys(value: String): String? { throw "json object keys intrinsic" }
fun jsonArrayCount(value: String): Int { throw "json array count intrinsic" }
fun jsonDecodeString(value: String): String? { throw "json string decode intrinsic" }
fun jsonDuplicateKey(value: String): String? { throw "json duplicate key intrinsic" }

fun rejectsDuplicates(policy: DuplicateKeyPolicy): Bool {
  match (policy) {
    case Reject => { return true }
    case FirstWins => { return false }
    case LastWins => { return false }
  }
}

pub fun defaultParseOptions(): ParseOptions {
  return ParseOptions(8 * 1024 * 1024, 64, rejectDuplicateKeys())
}

/// Validate one complete JSON value with bounded nesting and UTF-8 input.
pub fun isValid(value: String): Bool {
  return false
}

/// Return the first invalid byte offset, or -1 for a complete JSON value.
pub fun errorOffset(value: String): Int {
  return 0
}

/// Escape a string as a JSON string literal, including surrounding quotes.
pub fun escapeString(value: String): String? {
  return null
}

/// Validated, owned JSON value.
///
/// The bounded MVP preserves the input text in `raw` form and exposes
/// root-node classification and bounded source-backed traversal.
pub class Value(private val text: String) {
  /// Return the owned JSON text exactly as parsed.
  pub fun raw(): String {
    return text
  }

  /// Serialize the value. The MVP serializer returns the validated text.
  pub fun serialize(): String {
    return text
  }

  /// Return an independent owned value copy.
  pub fun clone(): Value {
    return Value(this.text)
  }

  /// Return the encoded byte length of this value.
  pub fun byteLength(): Int {
    return this.text.len
  }

  /// Return the maximum nested container depth of this value.
  pub fun depth(): Int {
    var current = 0
    var maximum = 0
    var quoted = false
    var escaped = false
    for (i in 0..this.text.len) {
      val byte = this.text.charAt(i)
      if (quoted) {
        if (escaped) {
          escaped = false
        } else if (byte == 92) {
          escaped = true
        } else if (byte == 34) {
          quoted = false
        }
      } else if (byte == 34) {
        quoted = true
      } else if (byte == 123 || byte == 91) {
        current = current + 1
        if (current > maximum) { maximum = current }
      } else if (byte == 125 || byte == 93) {
        current = current - 1
      }
    }
    return maximum
  }

  /// Return the root node kind: object, array, string, number, bool, or null.
  pub fun kind(): String {
    var index = 0
    while (index < text.len) {
      val byte = text.charAt(index)
      if (byte != 32 && byte != 9 && byte != 10 && byte != 13) {
        if (byte == 123) { return "object" }
        if (byte == 91) { return "array" }
        if (byte == 34) { return "string" }
        if (byte == 116 || byte == 102) { return "bool" }
        if (byte == 110) { return "null" }
        return "number"
      }
      index = index + 1
    }
    return "invalid"
  }

  /// Return true when the root node is a JSON object.
  pub fun isObject(): Bool { return this.kind() == "object" }
  /// Return true when the root node is a JSON array.
  pub fun isArray(): Bool { return this.kind() == "array" }
  /// Return true when the root node is a JSON string.
  pub fun isString(): Bool { return this.kind() == "string" }
  /// Return true when the root node is a JSON number.
  pub fun isNumber(): Bool { return this.kind() == "number" }
  /// Return true when the root node is a JSON boolean.
  pub fun isBool(): Bool { return this.kind() == "bool" }
  /// Return true when the root node is JSON null.
  pub fun isNull(): Bool { return this.kind() == "null" }

  /// Look up an object member by exact decoded key.
  pub fun get(key: String): Value? {
    val raw = jsonObjectGet(this.text, key)
    if (raw == null) { return null }
    return Value(raw!!)
  }

  /// Return one array element by zero-based index.
  pub fun at(index: Int): Value? {
    val raw = jsonArrayAt(this.text, index)
    if (raw == null) { return null }
    return Value(raw!!)
  }

  /// Decode a JSON string root into an owned Aura string.
  pub fun asString(): String? {
    return jsonDecodeString(this.text)
  }

  /// Return the object member names in source order.
  pub fun keys(): Array<String> {
    val encoded = jsonObjectKeys(this.text)
    if (encoded == null) { return Array<String>(0) }
    val count = jsonArrayCount(encoded!!)
    val result = Array<String>(count)
    for (i in 0..count) {
      val item = thisFromRaw(jsonArrayAt(encoded!!, i))
      if (item != null) {
        val key = item!!.asString()
        if (key != null) { result.set(i, key!!) }
      }
    }
    return result
  }
}

fun thisFromRaw(raw: String?): Value? {
  if (raw == null) { return null }
  return Value(raw!!)
}

/// Parse and retain one complete JSON value, or return null on invalid input.
pub fun parse(value: String): Value? {
  if (!isValid(value)) {
    return null
  }
  return Value(value)
}

/// Parse with explicit bounds and duplicate-key policy.
pub fun parseWithOptions(value: String, options: ParseOptions): Value? {
  if (options.maxBytes < 0 || options.maxDepth < 0) {
    return null
  }
  if (value.len > options.maxBytes || !isValid(value)) {
    return null
  }
  if (rejectsDuplicates(options.duplicateKeys) && jsonDuplicateKey(value) != null) {
    return null
  }
  val parsed = Value(value)
  if (parsed.depth() > options.maxDepth) {
    return null
  }
  return parsed
}

/// Typed parse result for bounded validation and traversal.
pub fun parseResult(value: String,
                    options: ParseOptions): JsonErrs.Outcome<Value, ParseError> {
  if (options.maxBytes < 0 || options.maxDepth < 0 || value.len > options.maxBytes) {
    return JsonErrs.failure(JsonLimitExceeded(options.maxBytes))
  }
  if (!isValid(value)) {
    return JsonErrs.failure(JsonInvalidInput(errorOffset(value)))
  }
  val duplicate = jsonDuplicateKey(value)
  if (rejectsDuplicates(options.duplicateKeys) && duplicate != null) {
    return JsonErrs.failure(JsonDuplicateKey(duplicate!!))
  }
  val parsed = Value(value)
  if (parsed.depth() > options.maxDepth) {
    return JsonErrs.failure(JsonLimitExceeded(options.maxDepth))
  }
  return JsonErrs.success(parsed)
}

/// Map a validated JSON value to an application type once derives/reflection
/// provide the serializer contract.
pub fun decode<T>(value: Value): T? {
  throw "std.json decode intrinsic"
}
