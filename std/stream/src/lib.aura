// std.stream -- bounded async reader/writer adapters over owned TCP streams.

package std.stream

import std.net as NetApi
import std.bytes as StreamBytes
import std.error as StreamErrs

/// Handler-scoped reader that keeps the underlying stream owned by the class.
pub class Reader(private val stream: ForeignHandle<Int>) {
    /// Read up to `capacity` bytes, suspending on descriptor readiness.
    pub async fun read(capacity: Int): String {
        val chunk: String = await readStream(stream, capacity)
        return chunk
    }

    /// Read exactly `length` bytes without converting through UTF-8 String.
    pub async fun readBytes(length: Int): StreamBytes.Buffer {
        return await NetApi.readExactly(stream, length)
    }

    /// Read exactly `length` bytes with a single absolute deadline.
    pub async fun readExactly(length: Int): StreamBytes.Buffer {
        return await readExactly(stream, length)
    }

    pub async fun readExactlyWithTimeout(length: Int, timeoutMs: Int): StreamBytes.Buffer {
        return await NetApi.readExactlyWithTimeout(stream, length, timeoutMs)
    }

    /// Typed read boundary for callers that handle transport failures locally.
    pub async fun readResult(capacity: Int): StreamErrs.Outcome<String, StreamErrs.NetError> {
        return await readStreamResult(stream, capacity)
    }

    /// Close the underlying stream. The operation is idempotent.
    pub fun close(): Bool {
        return closeStream(stream)
    }

    /// Typed close boundary for callers that handle invalid or closed handles.
    pub fun closeResult(): StreamErrs.Outcome<Bool, StreamErrs.NetError> {
        return closeStreamResult(stream)
    }
}

/// Handler-scoped writer that keeps the underlying stream owned by the class.
pub class Writer(private val stream: ForeignHandle<Int>) {
    /// Write all content, suspending until the stream accepts the bytes.
    pub async fun write(content: String): Int {
        val transferred: Int = await writeStream(stream, content)
        return transferred
    }

    /// Write bytes without converting through UTF-8 String.
    pub async fun writeBytes(bytes: StreamBytes.Buffer): Int {
        return await NetApi.writeAll(stream, bytes)
    }

    pub async fun writeAll(bytes: StreamBytes.Buffer): Int {
        return await writeAll(stream, bytes)
    }

    pub async fun writeAllWithTimeout(bytes: StreamBytes.Buffer, timeoutMs: Int): Int {
        return await NetApi.writeAllWithTimeout(stream, bytes, timeoutMs)
    }

    /// Typed write boundary for callers that handle transport failures locally.
    pub async fun writeResult(content: String): StreamErrs.Outcome<Int, StreamErrs.NetError> {
        return await writeStreamResult(stream, content)
    }

    /// Close the underlying stream. The operation is idempotent.
    pub fun close(): Bool {
        return closeStream(stream)
    }

    /// Typed close boundary for callers that handle invalid or closed handles.
    pub fun closeResult(): StreamErrs.Outcome<Bool, StreamErrs.NetError> {
        return closeStreamResult(stream)
    }
}
