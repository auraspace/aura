// std.error -- shared, transport-neutral error and Result values.

package std.error

/// Stable category for errors crossing a standard-library boundary.
pub enum ErrorKind {
  // RFC-007 canonical names.
  case InvalidInput
  case Unsupported
  case NotFound
  case PermissionDenied
  case WouldBlock
  case TimedOut
  case Cancelled
  case Disconnected
  case LimitExceeded
  case Protocol
  case System

  // Legacy alpha spellings retained while callers migrate.
  /// The caller supplied an invalid value or combination of values.
  case ErrorInvalidInput
  /// The requested resource does not exist.
  case ErrorNotFound
  /// The operation was rejected by the operating system or service policy.
  case ErrorPermission
  /// A local input/output operation failed.
  case ErrorIo
  /// A network transport operation failed.
  case ErrorNetwork
  /// An operation exceeded its time budget.
  case ErrorTimeout
  /// An operation was stopped by cooperative cancellation.
  case ErrorCancelled
  /// A peer sent data that violates the expected protocol.
  case ErrorProtocol
  /// A configured size, count, or resource bound was exceeded.
  case ErrorLimit
  /// The target resource is already closed.
  case ErrorClosed
  /// The requested operation is not supported on this target.
  case ErrorUnsupported
  /// The failure cannot be classified more specifically.
  case ErrorUnknown
}

/// Owned error payload suitable for returning from stdlib APIs.
///
/// `kind` is the stable category, `message` is human-readable detail, and
/// `code` carries the originating native status or protocol code.
pub class Error(pub val kind: ErrorKind, pub val message: String, pub val code: Int) {
  /// Whether a bounded caller may retry after a transient transport failure.
  pub fun isRetryable(): Bool {
    match (kind) {
      case ErrorIo => { return true }
      case ErrorNetwork => { return true }
      case ErrorTimeout => { return true }
      case ErrorCancelled => { return false }
      case ErrorInvalidInput => { return false }
      case ErrorNotFound => { return false }
      case ErrorPermission => { return false }
      case ErrorProtocol => { return false }
      case ErrorLimit => { return false }
      case ErrorClosed => { return false }
      case ErrorUnsupported => { return false }
      case ErrorUnknown => { return false }
      case InvalidInput => { return false }
      case Unsupported => { return false }
      case NotFound => { return false }
      case PermissionDenied => { return false }
      case WouldBlock => { return false }
      case TimedOut => { return true }
      case Cancelled => { return false }
      case Disconnected => { return true }
      case LimitExceeded => { return false }
      case Protocol => { return false }
      case System => { return false }
    }
  }
}

/// Construct a protocol error without exposing package-qualified constructors
/// at call sites that use an import alias.
pub fun protocol(message: String, code: Int): Error {
  return Error(ErrorProtocol(), message, code)
}

/// Construct a transport error without exposing enum variant qualification.
pub fun network(message: String, code: Int): Error {
  return Error(ErrorNetwork(), message, code)
}

/// Classify a bounded runtime transport diagnostic without exposing native
/// status storage through the public ABI. Runtime bridges use stable phrases
/// for timeout, cancellation, and peer-close paths; unknown text remains a
/// generic network failure.
pub fun transport(message: String, code: Int): Error {
  if (message.contains("timeout") || message.contains("timed out")) {
    return timedOut(message, code)
  }
  if (message.contains("cancel")) {
    return Error(Cancelled(), message, code)
  }
  if (message.contains("closed") || message.contains("disconnect") || message.contains("EOF")) {
    return disconnected(message, code)
  }
  return network(message, code)
}

/// Construct an invalid-input error.
pub fun invalidInput(message: String, code: Int): Error {
  return Error(ErrorInvalidInput(), message, code)
}

/// Construct a not-found error.
pub fun notFound(message: String, code: Int): Error {
  return Error(ErrorNotFound(), message, code)
}

pub fun invalidInputError(message: String, code: Int): Error {
  return Error(InvalidInput(), message, code)
}

pub fun unsupported(message: String, code: Int): Error {
  return Error(Unsupported(), message, code)
}

pub fun permissionDenied(message: String, code: Int): Error {
  return Error(PermissionDenied(), message, code)
}

pub fun wouldBlock(message: String, code: Int): Error {
  return Error(WouldBlock(), message, code)
}

pub fun timedOut(message: String, code: Int): Error {
  return Error(TimedOut(), message, code)
}

pub fun disconnected(message: String, code: Int): Error {
  return Error(Disconnected(), message, code)
}

pub fun limitExceeded(message: String, code: Int): Error {
  return Error(LimitExceeded(), message, code)
}

pub fun system(message: String, code: Int): Error {
  return Error(System(), message, code)
}

/// Package-owned error payloads reserved by RFC-007. Backend-specific enum
/// variants can be added without changing the common kind contract.
pub class OsError(pub val kind: ErrorKind, pub val message: String, pub val code: Int) {}
pub class NetError(pub val kind: ErrorKind, pub val message: String, pub val code: Int) {}
pub class DnsError(pub val kind: ErrorKind, pub val message: String, pub val code: Int) {}
pub class HttpError(pub val kind: ErrorKind, pub val message: String, pub val code: Int) {}

pub fun asOsError(error: Error): OsError {
  return OsError(error.kind, error.message, error.code)
}

pub fun asNetError(error: Error): NetError {
  return NetError(error.kind, error.message, error.code)
}

pub fun asDnsError(error: Error): DnsError {
  return DnsError(error.kind, error.message, error.code)
}

pub fun asHttpError(error: Error): HttpError {
  return HttpError(error.kind, error.message, error.code)
}

/// Map a native errno/status code to the stable ErrorKind category code:
/// 0 invalid input, 1 not found, 2 permission, 3 I/O, 4 network, 5 timeout,
/// 6 cancelled, 7 protocol, 8 limit, 9 closed, 10 unsupported, 11 unknown.
pub fun kindCode(code: Int): Int {
  // Keep the mapping portable: these errno/status values are stable across
  // the supported POSIX targets, while unknown values remain System/unknown.
  if (code == 22) { return 0 } // EINVAL
  if (code == 2) { return 1 } // ENOENT
  if (code == 13) { return 2 } // EACCES
  if (code == 11 || code == 35) { return 3 } // EAGAIN/EWOULDBLOCK
  if (code == 110 || code == 60) { return 5 } // ETIMEDOUT
  if (code == 125 || code == 89) { return 6 } // ECANCELED
  if (code == 104 || code == 54 || code == 57) { return 9 } // connection reset/closed
  if (code == 95 || code == 45) { return 10 } // ENOTSUP
  if (code >= 400 && code <= 599) { return 7 } // protocol/status failure
  if (code == 0) { return 11 }
  return 3
}

/// Non-throwing outcome shared by stdlib APIs.
///
/// The nominal name is intentionally distinct from `std.io.Result` until the
/// merged-package resolver can disambiguate same-named generic enums.
pub enum Outcome<T, E> {
  /// The operation completed and carries its value.
  case OutcomeOk(value: T)
  /// The operation failed and carries its error payload.
  case OutcomeErr(error: E)
}

/// Construct a successful shared result through an import-safe function API.
pub fun success<T, E>(value: T): Outcome<T, E> {
  return OutcomeOk(value)
}

/// Construct a failed shared result through an import-safe function API.
pub fun failure<T, E>(error: E): Outcome<T, E> {
  return OutcomeErr(error)
}

/// Inspect a result without requiring callers to import enum variant names.
pub fun isSuccess<T, E>(result: Outcome<T, E>): Bool {
  match (result) {
    case OutcomeOk(value) => { return true }
    case OutcomeErr(error) => { return false }
  }
}
