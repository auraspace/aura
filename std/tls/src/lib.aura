// std.tls -- OpenSSL-backed bounded TLS transport.

package std.tls

pub enum TlsError {
  case InvalidInput
  case HandshakeFailed
  case CertificateRejected
  case Unsupported
}

pub class Certificate(pub val subject: String, pub val issuer: String) {}

pub class Config(pub val serverName: String, pub val verifyPeer: Bool) {
  pub fun withServerName(name: String): Config {
    return Config(name, this.verifyPeer)
  }
}

pub class Connection(pub val endpoint: String) {
  pub async fun read(capacity: Int): String {
    throw "std.tls read intrinsic"
  }

  pub async fun write(content: String): Int {
    throw "std.tls write intrinsic"
  }

  pub fun close(): Unit {
    throw "std.tls close intrinsic"
  }
}

pub fun config(serverName: String, verifyPeer: Bool): Config {
  return Config(serverName, verifyPeer)
}

pub async fun connect(endpoint: String, options: Config): Connection {
  throw "std.tls connect intrinsic"
}

pub fun loadCertificate(path: String): Certificate {
  throw "std.tls loadCertificate intrinsic"
}
