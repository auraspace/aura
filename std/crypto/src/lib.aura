// std.crypto -- bounded cryptographic primitives and TLS contract.
//
// The names and value shapes are locked in the alpha contract. Hash/random
// primitives and TLS transport are compiler/runtime-backed.

package std.crypto

import std.bytes as CryptoBuffer

pub enum CryptoError {
  case InvalidInput
  case Unsupported
  case EntropyUnavailable
}

pub class Digest(pub val algorithm: String, pub val hex: String) {}

pub class TlsConfig(pub val serverName: String, pub val verifyPeer: Bool) {}

pub class TlsConnection(pub val endpoint: String) {
  pub async fun read(capacity: Int): String {
    throw "std.crypto TLS read intrinsic"
  }

  pub async fun write(content: String): Int {
    throw "std.crypto TLS write intrinsic"
  }

  pub async fun readBytes(capacity: Int): CryptoBuffer.Buffer {
    throw "std.crypto TLS readBytes intrinsic"
  }

  pub async fun readBytesWithTimeout(capacity: Int, timeoutMs: Int): CryptoBuffer.Buffer {
    throw "std.crypto TLS readBytesWithTimeout intrinsic"
  }

  pub async fun writeBytes(bytes: CryptoBuffer.Buffer): Int {
    throw "std.crypto TLS writeBytes intrinsic"
  }

  pub async fun writeBytesWithTimeout(bytes: CryptoBuffer.Buffer, timeoutMs: Int): Int {
    throw "std.crypto TLS writeBytesWithTimeout intrinsic"
  }

  pub fun close(): Unit {
    throw "std.crypto TLS close intrinsic"
  }
}

pub fun randomBytes(length: Int): String {
  throw "std.crypto randomBytes intrinsic"
}

/// Secure random bytes with an explicit binary representation.
pub fun randomBytesBuffer(length: Int): CryptoBuffer.Buffer {
  throw "std.crypto randomBytesBuffer intrinsic"
}

pub fun sha256(value: String): Digest {
  throw "std.crypto sha256 intrinsic"
}

pub fun hmacSha256(key: String, value: String): Digest {
  throw "std.crypto hmacSha256 intrinsic"
}

pub fun md5Bytes(value: CryptoBuffer.Buffer): CryptoBuffer.Buffer {
  throw "std.crypto md5Bytes intrinsic"
}

pub fun sha256Bytes(value: CryptoBuffer.Buffer): CryptoBuffer.Buffer {
  throw "std.crypto sha256Bytes intrinsic"
}

pub fun hmacSha256Bytes(key: CryptoBuffer.Buffer, value: CryptoBuffer.Buffer): CryptoBuffer.Buffer {
  throw "std.crypto hmacSha256Bytes intrinsic"
}

/// PBKDF2-HMAC-SHA-256, suitable for SCRAM-SHA-256 salted passwords.
pub fun pbkdf2Sha256(password: CryptoBuffer.Buffer, salt: CryptoBuffer.Buffer, iterations: Int, length: Int): CryptoBuffer.Buffer {
  throw "std.crypto pbkdf2Sha256 intrinsic"
}

/// Hash a password using a versioned PBKDF2-HMAC-SHA-256 record with a fresh
/// random salt. The returned record is safe to store; it never contains the
/// clear-text password.
pub fun hashPassword(password: String): String {
  throw "std.crypto hashPassword intrinsic"
}

/// Verify a stored password record in constant time. Malformed or unsupported
/// records return false rather than becoming a password oracle.
pub fun verifyPassword(password: String, stored: String): Bool {
  throw "std.crypto verifyPassword intrinsic"
}

pub fun constantTimeEquals(left: String, right: String): Bool {
  throw "std.crypto constantTimeEquals intrinsic"
}

pub fun tlsConfig(serverName: String, verifyPeer: Bool): TlsConfig {
  return TlsConfig(serverName, verifyPeer)
}

pub async fun connectTls(endpoint: String, config: TlsConfig): TlsConnection {
  throw "std.crypto connectTls intrinsic"
}
