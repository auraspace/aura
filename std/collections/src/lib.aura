// RFC-007 standard collections.
// C14: Hashable + one generic open-addressing HashMap<K, V>.
package std.collections

/// Growable list backed by the compiler's owning Array<T> storage.
pub class List<T>(private val items: Array<T>) {
  pub static fun of(first: T, second: T, third: T): List<T> {
    val result = List<T>(Array<T>(0))
    result.push(first)
    result.push(second)
    result.push(third)
    return result
  }

  pub fun len(): Int { return this.items.len }
  pub fun isEmpty(): Bool { return this.items.len == 0 }
  pub fun get(index: Int): T { return this.items.get(index) }
  pub fun set(index: Int, value: T): Unit { this.items.set(index, value) }
  pub fun push(value: T): Unit { this.items.push(value) }
  pub fun pop(): T { return this.items.pop() }
  pub fun clear(): Unit { this.items.clear() }

  pub fun map<R>(f: (T) -> R): List<R> {
    val result = List<R>(Array<R>(0))
    for (i in 0..this.items.len) {
      result.push(f(this.items.get(i)))
    }
    return result
  }
}

/// Compatibility spelling for callers that do not use static members.
pub fun listOf<T>(first: T, second: T, third: T): List<T> {
  return List.of(first, second, third)
}

pub fun list<T>(): List<T> {
  return List<T>(Array<T>(0))
}

/// Minimal indexed iteration contract used by `for-in` lowering.
pub interface Iterable<E> {
  /// Return the number of elements exposed by the iterable.
  fun len(): Int
  /// Return the element at logical index `i`.
  fun get(i: Int): E
}

/// Hash protocol. Int and String have compiler-backed implementations.
pub interface Hashable {
  /// Return a stable hash consistent with equality.
  fun hash(): Int
}

/// Linear-search map backed by parallel key and value arrays.
///
/// `keys` is the public key storage used by iteration; values at the same
/// indexes in the private parallel storage belong to those keys.
pub class Map<K, V>(pub val keys: Array<K>, val vals: Array<V>) {
  /// Return the number of key/value pairs.
  pub fun len(): Int { return this.keys.len }
  /// Return whether the map contains no entries.
  pub fun isEmpty(): Bool { return this.keys.len == 0 }

  /// Insert or replace `k`; return true only when a new key was inserted.
  pub fun put(k: K, v: V): Bool {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) {
        this.vals.set(i, v)
        return false
      }
    }
    this.keys.push(k)
    this.vals.push(v)
    return true
  }

  /// Return the value for `k`, or null when the key is absent.
  pub fun get(k: K): V? {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) { return this.vals.get(i) }
    }
    return null
  }

  /// Return the value for `k`, or `default` when the key is absent.
  pub fun getOr(k: K, default: V): V {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) { return this.vals.get(i) }
    }
    return default
  }

  /// Return whether `k` is present.
  pub fun contains(k: K): Bool {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) { return true }
    }
    return false
  }

  /// Remove `k` and return whether an entry was removed.
  pub fun remove(k: K): Bool {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) {
        val last = this.keys.len - 1
        if (i != last) {
          this.keys.set(i, this.keys.get(last))
          this.vals.set(i, this.vals.get(last))
        }
        val _dk = this.keys.pop()
        val _dv = this.vals.pop()
        return true
      }
    }
    return false
  }

  /// Remove all entries from the map.
  pub fun clear() {
    this.keys.clear()
    this.vals.clear()
  }
}

/// Factory retained under a distinct name because Aura does not overload
/// functions by arity; `map` is now the generic HOF below.
pub fun map_string_int(): Map<String, Int> {
  return Map<String, Int>(Array(0), Array(0))
}

/// Linear-search set backed by an owned value array.
pub class Set<T>(pub val keys: Array<T>) {
  /// Return the number of values in the set.
  pub fun len(): Int { return this.keys.len }
  /// Return the value at logical index `i`.
  pub fun get(i: Int): T { return this.keys.get(i) }
  /// Return whether the set contains no values.
  pub fun isEmpty(): Bool { return this.keys.len == 0 }

  /// Return whether `k` is present.
  pub fun contains(k: T): Bool {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) { return true }
    }
    return false
  }

  /// Add `k` and return false when it was already present.
  pub fun add(k: T): Bool {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) { return false }
    }
    this.keys.push(k)
    return true
  }

  /// Remove `k` and return whether a value was removed.
  pub fun remove(k: T): Bool {
    for (i in 0..this.keys.len) {
      if (this.keys.get(i) == k) {
        val last = this.keys.len - 1
        if (i != last) { this.keys.set(i, this.keys.get(last)) }
        val _dropped = this.keys.pop()
        return true
      }
    }
    return false
  }

  /// Remove all values from the set.
  pub fun clear() { this.keys.clear() }
}

/// Construct an empty `Set<String>`.
pub fun set(): Set<String> { return Set<String>(Array(0)) }

/// One immutable key/value pair captured by `HashMap.entries()`.
///
/// `key` is the key snapshot and `value` is the value observed at capture
/// time; later map mutation does not update either field.
pub class HashMapEntry<K, V>(pub val key: K, pub val value: V) {
}

/// A key-based mutation handle returned by HashMap.entry().
///
/// The handle retains its map but never a table slot. set() therefore resolves
/// the key at call time and stays valid across rehashing and GC.
pub class HashMapEntryHandle<K : Hashable, V>(val map: HashMap<K, V>, val key: K) {
  /// Replace the value only when this key is still present.
  pub fun set(value: V): Bool { return this.map.replace(this.key, value) }
}

/// An invalidation-checked live view of one HashMap entry.
///
/// It retains the map but no bucket pointer. Structural map changes advance the
/// map epoch, invalidating this view before a later get() or set() can observe
/// a rehashed or removed slot.
pub class HashMapLiveEntry<K : Hashable, V>(val map: HashMap<K, V>, pub val key: K, val epoch: Int) {
  /// Return whether this view still refers to a present, unmodified entry.
  pub fun isValid(): Bool {
    return this.map.epoch == this.epoch && this.map.contains(this.key)
  }

  /// Read the entry value, or null when the view is invalid.
  pub fun get(): V? {
    if (!this.isValid()) { return null }
    return this.map.get(this.key)
  }

  /// Replace the entry value while the view remains valid.
  pub fun set(value: V): Bool {
    if (!this.isValid()) { return false }
    return this.map.replace(this.key, value)
  }
}

/// Read-only snapshot iterator over HashMap keys.
pub class HashMapKeyIterator<K>(val items: Array<K>) {
  /// Return the number of snapshotted keys.
  pub fun len(): Int { return this.items.len }
  /// Return the snapshotted key at `i`.
  pub fun get(i: Int): K { return this.items.get(i) }
}

/// Read-only snapshot iterator over HashMap entries.
pub class HashMapEntryIterator<K, V>(val items: Array<HashMapEntry<K, V>>) {
  /// Return the number of snapshotted entries.
  pub fun len(): Int { return this.items.len }
  /// Return the snapshotted entry at `i`.
  pub fun get(i: Int): HashMapEntry<K, V> { return this.items.get(i) }
}

/// Read-only snapshot iterator over HashSet keys.
pub class HashSetIterator<T>(val items: Array<T>) {
  /// Return the number of snapshotted keys.
  pub fun len(): Int { return this.items.len }
  /// Return the snapshotted key at `i`.
  pub fun get(i: Int): T { return this.items.get(i) }
}

/// Invalidation-checked live iterator over HashMap keys.
pub class HashMapLiveKeyIterator<K : Hashable, V>(val map: HashMap<K, V>, var slot: Int, val epoch: Int) {
  /// Return whether structural map changes have not invalidated this cursor.
  pub fun isValid(): Bool { return this.map.epoch == this.epoch }

  /// Return whether a further live key is available.
  pub fun hasNext(): Bool {
    if (!this.isValid()) { return false }
    for (i in this.slot..this.map.state.len) {
      if (this.map.state.get(i) == 1) { return true }
    }
    return false
  }

  /// Return and advance to the next live key, or null at end/invalidation.
  pub fun next(): K? {
    if (!this.isValid()) { return null }
    for (i in this.slot..this.map.state.len) {
      if (this.map.state.get(i) == 1) {
        slot = i + 1
        return this.map.keys.get(i)
      }
    }
    return null
  }
}

/// Invalidation-checked live iterator over HashMap entries.
/// Structural map mutation invalidates the cursor; value replacement does not.
pub class HashMapLiveIterator<K : Hashable, V>(val map: HashMap<K, V>, var slot: Int, val epoch: Int) {
  /// Return whether structural map changes have not invalidated this cursor.
  pub fun isValid(): Bool { return this.map.epoch == this.epoch }

  /// Return whether a further live entry is available.
  pub fun hasNext(): Bool {
    if (!this.isValid()) { return false }
    for (i in this.slot..this.map.state.len) {
      if (this.map.state.get(i) == 1) { return true }
    }
    return false
  }

  /// Return and advance to the next live entry, or null at end/invalidation.
  pub fun next(): HashMapLiveEntry<K, V>? {
    if (!this.isValid()) { return null }
    for (i in this.slot..this.map.state.len) {
      if (this.map.state.get(i) == 1) {
        slot = i + 1
        return HashMapLiveEntry<K, V>(this.map, this.map.keys.get(i), this.epoch)
      }
    }
    return null
  }
}

/// Invalidation-checked live iterator over HashSet keys.
/// Structural table mutation invalidates the cursor.
pub class HashSetLiveIterator<T : Hashable>(val table: HashMap<T, Bool>, var slot: Int, val epoch: Int) {
  /// Return whether structural set changes have not invalidated this cursor.
  pub fun isValid(): Bool { return this.table.epoch == this.epoch }

  /// Return whether a further live key is available.
  pub fun hasNext(): Bool {
    if (!this.isValid()) { return false }
    for (i in this.slot..this.table.state.len) {
      if (this.table.state.get(i) == 1) { return true }
    }
    return false
  }

  /// Return and advance to the next live key, or null at end/invalidation.
  pub fun next(): T? {
    if (!this.isValid()) { return null }
    for (i in this.slot..this.table.state.len) {
      if (this.table.state.get(i) == 1) {
        slot = i + 1
        return this.table.keys.get(i)
      }
    }
    return null
  }
}

/// Open-addressing map. `state` uses 0 for empty, 1 for full, and 2 for a
/// tombstone. `epoch` changes after structural mutation and invalidates live
/// iterators and entry views. The key bound supplies hash and equality.
pub class HashMap<K : Hashable, V>(var keys: Array<K>, var vals: Array<V>, var state: Array<Int>, var epoch: Int) {
  /// Return the number of allocated table slots, including empty slots.
  pub fun capacity(): Int { return this.keys.len }

  /// Snapshot iterator. Later map mutation does not affect this iterator.
  pub fun keyIterator(): HashMapKeyIterator<K> {
    return HashMapKeyIterator<K>(this.keyArray())
  }

  /// Snapshot iterator. Later map mutation does not affect this iterator.
  pub fun entryIterator(): HashMapEntryIterator<K, V> {
    return HashMapEntryIterator<K, V>(this.entries())
  }

  /// Live iterator. Structural mutation invalidates the cursor.
  pub fun liveKeyIterator(): HashMapLiveKeyIterator<K, V> {
    return HashMapLiveKeyIterator<K, V>(this, 0, this.epoch)
  }

  /// Live iterator yielding invalidation-checked entry views.
  pub fun liveEntryIterator(): HashMapLiveIterator<K, V> {
    return HashMapLiveIterator<K, V>(this, 0, this.epoch)
  }

  /// Return live keys in logical table order, excluding empty/tombstone slots.
  pub fun keyArray(): Array<K> {
    val out: Array<K> = Array(0)
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1) { out.push(this.keys.get(i)) }
    }
    return out
  }

  /// Return values in the same logical order as keyArray().
  pub fun valueArray(): Array<V> {
    val out: Array<V> = Array(0)
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1) { out.push(this.vals.get(i)) }
    }
    return out
  }

  /// Return live key/value pairs in logical table order without mutating this map.
  pub fun entries(): Array<HashMapEntry<K, V>> {
    val out: Array<HashMapEntry<K, V>> = Array(0)
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1) {
        out.push(HashMapEntry<K, V>(this.keys.get(i), this.vals.get(i)))
      }
    }
    return out
  }

  /// Return a mutation handle for an existing key, or null when it is absent.
  /// The handle is key-based rather than a borrowed bucket reference.
  pub fun entry(k: K): HashMapEntryHandle<K, V>? {
    if (!this.contains(k)) { return null }
    return HashMapEntryHandle<K, V>(this, k)
  }

  /// Return a live entry view for an existing key, or null when it is absent.
  /// Any structural map mutation invalidates the returned view.
  pub fun liveEntry(k: K): HashMapLiveEntry<K, V>? {
    if (!this.contains(k)) { return null }
    return HashMapLiveEntry<K, V>(this, k, this.epoch)
  }

  /// Return the number of live entries.
  pub fun len(): Int {
    var n: Int = 0
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1) { n = n + 1 }
    }
    return n
  }

  /// Return whether the map has no live entries.
  pub fun isEmpty(): Bool {
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1) { return false }
    }
    return true
  }

  /// Double capacity and rehash live entries.
  pub fun grow() {
    val old_n = this.keys.len
    val new_n = if (old_n < 4) { 4 } else { old_n * 2 }
    val nk: Array<K> = Array(new_n)
    val nv: Array<V> = Array(new_n)
    val ns: Array<Int> = Array(new_n)
    for (i in 0..old_n) {
      if (this.state.get(i) == 1) {
        val ok = this.keys.get(i)
        val ov = this.vals.get(i)
        var j: Int = ok.hash() % new_n
        for (step in 0..new_n) {
          if (ns.get(j) == 0) {
            nk.set(j, ok)
            nv.set(j, ov)
            ns.set(j, 1)
            break
          }
          j = (j + 1) % new_n
        }
      }
    }
    keys = nk
    vals = nv
    state = ns
    epoch = epoch + 1
  }

  /// Insert or replace `k`; return true only when a new key was inserted.
  pub fun put(k: K, v: V): Bool {
    var n = this.keys.len
    if (n == 0) {
      keys = Array(4)
      vals = Array(4)
      state = Array(4)
      n = this.keys.len
    }
    var live: Int = 0
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1) { live = live + 1 }
    }
    var i: Int = k.hash() % n
    var first_tomb: Int = -1
    for (step in 0..n) {
      val st = this.state.get(i)
      if (st == 0) { break }
      if (st == 2) {
        if (first_tomb < 0) { first_tomb = i }
      } else if (this.keys.get(i) == k) {
        this.vals.set(i, v)
        return false
      }
      i = (i + 1) % n
    }
    if (live * 2 >= n) {
      val old_n = this.keys.len
      val new_n = if (old_n < 4) { 4 } else { old_n * 2 }
      val nk: Array<K> = Array(new_n)
      val nv: Array<V> = Array(new_n)
      val ns: Array<Int> = Array(new_n)
      for (gi in 0..old_n) {
        if (this.state.get(gi) == 1) {
          val ok = this.keys.get(gi)
          val ov = this.vals.get(gi)
          var j: Int = ok.hash() % new_n
          for (step in 0..new_n) {
            if (ns.get(j) == 0) {
              nk.set(j, ok)
              nv.set(j, ov)
              ns.set(j, 1)
              break
            }
            j = (j + 1) % new_n
          }
        }
      }
      keys = nk
      vals = nv
      state = ns
      n = this.keys.len
    }
    i = k.hash() % n
    first_tomb = -1
    for (step in 0..n) {
      val st = this.state.get(i)
      if (st == 0) {
        val slot = if (first_tomb >= 0) { first_tomb } else { i }
        this.keys.set(slot, k)
        this.vals.set(slot, v)
        this.state.set(slot, 1)
        epoch = epoch + 1
        return true
      }
      if (st == 2) {
        if (first_tomb < 0) { first_tomb = i }
      } else if (this.keys.get(i) == k) {
        this.vals.set(i, v)
        return false
      }
      i = (i + 1) % n
    }
    if (first_tomb >= 0) {
      this.keys.set(first_tomb, k)
      this.vals.set(first_tomb, v)
      this.state.set(first_tomb, 1)
      epoch = epoch + 1
      return true
    }
    return false
  }

  /// Return the value for `k`, or null when the key is absent.
  pub fun get(k: K): V? {
    val n = this.keys.len
    if (n == 0) { return null }
    var i: Int = k.hash() % n
    for (step in 0..n) {
      val st = this.state.get(i)
      if (st == 0) { return null }
      if (st == 1 && this.keys.get(i) == k) { return this.vals.get(i) }
      i = (i + 1) % n
    }
    return null
  }

  /// Return the value for `k`, or `default` when the key is absent.
  pub fun getOr(k: K, default: V): V {
    val got = this.get(k)
    return got ?: default
  }

  /// Return whether `k` is present.
  pub fun contains(k: K): Bool {
    val n = this.keys.len
    if (n == 0) { return false }
    var i: Int = k.hash() % n
    for (step in 0..n) {
      val st = this.state.get(i)
      if (st == 0) { return false }
      if (st == 1 && this.keys.get(i) == k) { return true }
      i = (i + 1) % n
    }
    return false
  }

  /// True when a live entry stores v. Empty and tombstone slots are ignored.
  pub fun containsValue(v: V): Bool {
    for (i in 0..this.state.len) {
      if (this.state.get(i) == 1 && this.vals.get(i) == v) { return true }
    }
    return false
  }

  /// Replace an existing value without inserting a missing key.
  pub fun replace(k: K, v: V): Bool {
    val n = this.keys.len
    if (n == 0) { return false }
    var i: Int = k.hash() % n
    for (step in 0..n) {
      val st = this.state.get(i)
      if (st == 0) { return false }
      if (st == 1 && this.keys.get(i) == k) {
        this.vals.set(i, v)
        return true
      }
      i = (i + 1) % n
    }
    return false
  }

  /// Remove `k`, invalidate live cursors, and report whether it existed.
  pub fun remove(k: K): Bool {
    val n = this.keys.len
    if (n == 0) { return false }
    var i: Int = k.hash() % n
    for (step in 0..n) {
      val st = this.state.get(i)
      if (st == 0) { return false }
      if (st == 1 && this.keys.get(i) == k) {
        this.state.set(i, 2)
        epoch = epoch + 1
        return true
      }
      i = (i + 1) % n
    }
    return false
  }

  /// Remove all entries and invalidate live cursors when the table changed.
  pub fun clear() {
    var changed = false
    for (i in 0..this.state.len) {
      if (this.state.get(i) != 0) { changed = true }
      this.state.set(i, 0)
    }
    if (changed) { epoch = epoch + 1 }
  }
}

/// Construct an empty `HashMap<String, Int>` with the default capacity.
pub fun hash_map(): HashMap<String, Int> {
  return HashMap<String, Int>(Array(16), Array(16), Array(16), 0)
}

/// Construct an empty `HashMap<String, String>` with the default capacity.
pub fun hash_map_str(): HashMap<String, String> {
  return HashMap<String, String>(Array(16), Array(16), Array(16), 0)
}

/// Open-addressing set backed by the generic `HashMap<T, Bool>`.
///
/// `table` owns the storage; callers should use the set methods rather than
/// mutating the backing map directly.
pub class HashSet<T : Hashable>(var table: HashMap<T, Bool>) {
  /// Return the allocated table capacity.
  pub fun capacity(): Int { return this.table.capacity() }
  /// Return the number of live keys.
  pub fun len(): Int { return this.table.len() }
  /// Return whether the set is empty.
  pub fun isEmpty(): Bool { return this.table.isEmpty() }

  /// Snapshot iterator. Later set mutation does not affect this iterator.
  pub fun iterator(): HashSetIterator<T> {
    return HashSetIterator<T>(this.toArray())
  }

  /// Live iterator. Structural mutation invalidates the cursor.
  pub fun liveIterator(): HashSetLiveIterator<T> {
    return HashSetLiveIterator<T>(this.table, 0, this.table.epoch)
  }

  /// Return live keys in logical table order.
  pub fun toArray(): Array<T> { return this.table.keyArray() }

  /// Add `k` and return false when it was already present.
  pub fun add(k: T): Bool { return this.table.put(k, true) }
  /// Return whether `k` is present.
  pub fun contains(k: T): Bool { return this.table.contains(k) }

  /// True when every requested key is present; an empty request is true.
  pub fun containsAll(keys: Array<T>): Bool {
    for (key in keys) {
      if (!this.contains(key)) { return false }
    }
    return true
  }

  /// Remove `k` and return whether a key was removed.
  pub fun remove(k: T): Bool { return this.table.remove(k) }
  /// Remove all keys and invalidate live iterators when the table changed.
  pub fun clear() { this.table.clear() }

  /// Return the live key at logical index i, for duck Iterable / for-in.
  pub fun get(i: Int): T {
    var seen: Int = 0
    for (slot in 0..this.table.state.len) {
      if (this.table.state.get(slot) == 1) {
        if (seen == i) { return this.table.keys.get(slot) }
        seen = seen + 1
      }
    }
    return this.table.keys.get(i)
  }
}

/// Construct an empty `HashSet<String>` with the default capacity.
pub fun hash_set(): HashSet<String> {
  return HashSet<String>(HashMap<String, Bool>(Array(16), Array(16), Array(16), 0))
}

/// Transform each live map entry in logical table order.
/// Free-function form keeps generic type inference compatible with C2b.
pub fun map_hash_map_values<K : Hashable, V, R>(h: HashMap<K, V>, f: (K, V) -> R): Array<R> {
  val out: Array<R> = Array(0)
  for (i in 0..h.state.len) {
    if (h.state.get(i) == 1) { out.push(f(h.keys.get(i), h.vals.get(i))) }
  }
  return out
}

/// Keep live set keys matching the predicate in logical table order.
pub fun filter_hash_set<T : Hashable>(s: HashSet<T>, pred: (T) -> Bool): Array<T> {
  val out: Array<T> = Array(0)
  for (x in s) { if (pred(x)) { out.push(x) } }
  return out
}

/// Transform live set keys in logical table order.
pub fun map_hash_set<T : Hashable, R>(s: HashSet<T>, f: (T) -> R): Array<R> {
  val out: Array<R> = Array(0)
  for (x in s) { out.push(f(x)) }
  return out
}

/// Generic higher-order helpers. Type arguments may be explicit, for example
/// `map<Int, String>(xs, f)`, or inferred from the arguments and result.
pub fun map<T, R>(xs: Array<T>, f: (T) -> R): Array<R> {
  val out: Array<R> = Array(0)
  for (x in xs) { out.push(f(x)) }
  return out
}

/// Keep elements of `xs` whose predicate returns true, preserving order.
pub fun filter<T>(xs: Array<T>, pred: (T) -> Bool): Array<T> {
  val out: Array<T> = Array(0)
  for (x in xs) { if (pred(x)) { out.push(x) } }
  return out
}

/// Fold `xs` from left to right, starting with `init`.
pub fun fold<T, A>(xs: Array<T>, init: A, f: (A, T) -> A): A {
  var acc = init
  for (x in xs) { acc = f(acc, x) }
  return acc
}

/// Compatibility wrappers for the pre-generic API.
/// Map integer values while retaining the legacy API name.
pub fun map_ints(xs: Array<Int>, f: (Int) -> Int): Array<Int> {
  return map<Int, Int>(xs, f)
}

/// Filter integer values while retaining the legacy API name.
pub fun filter_ints(xs: Array<Int>, pred: (Int) -> Bool): Array<Int> {
  return filter<Int>(xs, pred)
}

/// Fold integer values while retaining the legacy API name.
pub fun fold_ints(xs: Array<Int>, init: Int, f: (Int, Int) -> Int): Int {
  return fold<Int, Int>(xs, init, f)
}

/// Map strings while retaining the legacy API name.
pub fun map_strings(xs: Array<String>, f: (String) -> String): Array<String> {
  return map<String, String>(xs, f)
}

/// Filter strings while retaining the legacy API name.
pub fun filter_strings(xs: Array<String>, pred: (String) -> Bool): Array<String> {
  return filter<String>(xs, pred)
}

/// Fold strings while retaining the legacy API name.
pub fun fold_strings(xs: Array<String>, init: String, f: (String, String) -> String): String {
  return fold<String, String>(xs, init, f)
}

/// Join all parts with `sep`; return an empty string for an empty array.
pub fun join(parts: Array<String>, sep: String): String {
  if (parts.len == 0) { return "" }
  var out: String = parts.get(0)
  for (i in 1..parts.len) { out = out + sep + parts.get(i) }
  return out
}
