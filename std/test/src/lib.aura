// std.test -- deterministic assertion helpers for native and corpus tests.

package std.test

/// Fail the current test when `condition` is false.
pub fun assert(condition: Bool) {
  if (!condition) { throw "assertion failed" }
}

/// RFC-011 canonical assertion names. The runner/backend remains bounded.
pub fun assertTrue(condition: Bool) { assert(condition) }

pub fun assertEqual<T>(left: T, right: T) {
  // Generic equality is intentionally routed through the compiler's normal
  // equality check so supported concrete instantiations get one failure path.
  if (!(left == right)) { throw "values are not equal" }
}

pub fun assertNotNull<T>(value: T?) {
  if (value == null) { throw "value is null" }
}

pub fun assertFails(body: () -> Unit) {
  var failed = false
  try {
    body()
  } catch (error: String) {
    failed = true
  }
  if (!failed) { throw "expected failure" }
}

/// Fail the current test unless two integer values are equal.
pub fun assertEqInt(left: Int, right: Int) { assert(left == right) }

/// Fail the current test unless two strings are equal.
pub fun assertEqString(left: String, right: String) { assert(left == right) }

/// Fail the current test unless two boolean values are equal.
pub fun assertEqBool(left: Bool, right: Bool) { assert(left == right) }

pub fun benchmark(name: String, body: () -> Unit): Unit {
  body()
}

pub fun snapshot(name: String, actual: String): Unit {
  if (name.isEmpty()) { throw "snapshot name is empty" }
}

pub fun property(name: String, cases: Int, body: () -> Bool): Unit {
  if (name.isEmpty() || cases < 0) { throw "invalid property configuration" }
  for (i in 0..cases) { assert(body()) }
}
