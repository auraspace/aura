/// Read an entire regular file as a String (UTF-8 bytes, no embedded NUL).
/// Throws on missing path, I/O error, oversized file (>256 MiB), or embedded NUL.
pub fun readFile(path: String): String {
    throw "std.io readFile intrinsic"
}

/// Soft read: same content rules as `readFile`, but returns `null` on missing
/// path, I/O error, oversized file (>256 MiB), empty path, OOM, or embedded NUL.
/// Prefer this when absence / soft failure is expected; use `readFile` to throw.
pub fun tryReadFile(path: String): String? {
    throw "std.io tryReadFile intrinsic"
}

/// Write `content` to `path`, creating or truncating the file.
/// Throws on I/O error.
pub fun writeFile(path: String, content: String) {
    // Body replaced by codegen with aura_write_file(path, content).
}

/// Soft write: create/truncate `path` with `content`. Returns `true` on success;
/// `false` on empty path, open/write/flush/close failure (does not throw).
/// Prefer this when soft failure is expected; use `writeFile` to throw.
pub fun tryWriteFile(path: String, content: String): Bool {
    throw "std.io tryWriteFile intrinsic"
}

/// Non-throwing read with an explicit owned error payload.
/// `Ok` contains the same owned String as `tryReadFile`; `Err` contains a
/// fresh String describing the failed operation. Existing readFile and
/// tryReadFile behavior is unchanged.
pub fun readFileResult(path: String): Result<String, String> {
    val content = tryReadFile(path)
    if (content == null) {
        return Err("readFile failed: " + path)
    }
    return Ok(content!!)
}

/// Non-throwing write with an explicit owned error payload.
/// `Ok(true)` indicates that the file was fully written and closed; `Err`
/// contains a fresh String describing the failed operation.
pub fun writeFileResult(path: String, content: String): Result<Bool, String> {
    if (tryWriteFile(path, content)) {
        return Ok(true)
    }
    return Err("writeFile failed: " + path)
}

/// Append `content` to `path`, creating the file if needed.
/// Throws on I/O error.
pub fun appendFile(path: String, content: String) {
    // Body replaced by codegen with aura_append_file(path, content).
}

/// true if `path` exists and is a regular file.
pub fun fileExists(path: String): Bool {
    throw "std.io fileExists intrinsic"
}

/// Non-throwing regular-file existence check with an owned error payload.
pub fun fileExistsResult(path: String): Result<Bool, String> {
    try {
        return Ok(fileExists(path))
    } catch (error: String) {
        return Err(error)
    }
}

/// Byte size of a regular file at `path`.
/// Throws if missing or not a regular file.
pub fun fileSize(path: String): Int {
    throw "std.io fileSize intrinsic"
}

/// Non-throwing regular-file size query with an owned error payload.
pub fun fileSizeResult(path: String): Result<Int, String> {
    try {
        return Ok(fileSize(path))
    } catch (error: String) {
        return Err(error)
    }
}

/// Open a regular file and return an owned opaque handle. Mode is 0 for read,
/// 1 for write/truncate, 2 for read/write, and 3 for append. The binding
/// closes and destroys the resource when it leaves lexical scope.
pub fun openFile(path: String, mode: Int): ForeignHandle<Int> {
    throw "openFile intrinsic"
}

/// Read up to `capacity` bytes from a nonblocking descriptor and suspend the
/// current task until the descriptor is readable. EOF returns an empty String.
pub async fun readFd(fd: Int, capacity: Int): String {
    throw "std.io readFd intrinsic"
}

/// Non-throwing async descriptor read with an owned error payload.
pub async fun readFdResult(fd: Int, capacity: Int): Result<String, String> {
    try {
        return Ok(await readFd(fd, capacity))
    } catch (error: String) {
        return Err(error)
    }
}

/// Write all content to a nonblocking descriptor and return its byte count.
pub async fun writeFd(fd: Int, content: String): Int {
    throw "std.io writeFd intrinsic"
}

/// Non-throwing async descriptor write with an owned error payload.
pub async fun writeFdResult(fd: Int, content: String): Result<Int, String> {
    try {
        return Ok(await writeFd(fd, content))
    } catch (error: String) {
        return Err(error)
    }
}
