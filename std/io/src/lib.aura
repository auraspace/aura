// std.io — console + file I/O (runtime intrinsics).

package std.io

/// Terminal outcome for an asynchronous task join.
pub enum TaskError {
    /// The task failed with a normalized owned error message.
    case Failed(error: String)
    /// The task was cooperatively cancelled before producing a value.
    case Cancelled
}

/// Return the concrete exception type retained by a failed task, when the
/// failure crossed an async boundary with typed payload metadata.
/// The returned String is an owned copy; `null` means no typed exception tag.
pub fun taskErrorTypeName(error: TaskError): String? {
    throw "std.io taskErrorTypeName intrinsic"
}

/// Source identity attached to a failed task, or zero when unavailable.
pub fun taskErrorSourceId(error: TaskError): Int {
    throw "std.io taskErrorSourceId intrinsic"
}

/// Start byte offset of the failed task's source span, or zero when absent.
pub fun taskErrorSpanStart(error: TaskError): Int {
    throw "std.io taskErrorSpanStart intrinsic"
}

/// End byte offset of the failed task's source span, or zero when absent.
pub fun taskErrorSpanEnd(error: TaskError): Int {
    throw "std.io taskErrorSpanEnd intrinsic"
}

/// Non-throwing result used by task joins and structured file wrappers below.
/// Error strings are owned Aura Strings; callers may retain or return them.
pub enum Result<T, E> {
    /// A successful operation carrying `value`.
    case Ok(value: T)
    /// A failed operation carrying `error`.
    case Err(error: E)
}

/// Process argument vector as `Array<String>`.
/// `args()[0]` is the program name (`argv[0]`); user flags start at index 1.
/// Values are process-lifetime views of the OS argv (not independent copies).
pub fun args(): Array<String> {
    throw "std.io args intrinsic"
}

/// Read one line from stdin without the trailing `\n` or `\r\n`.
/// Returns `null` on EOF (including immediate EOF with no bytes).
/// An empty line is `""` (not null). Throws String if the line exceeds 1 MiB.
pub fun readLine(): String? {
    throw "std.io readLine intrinsic"
}

/// Non-throwing line read. `Ok(null)` is EOF; `Err` carries an I/O message.
pub fun readLineResult(): Result<String?, String> {
    try {
        return Ok(readLine())
    } catch (error: String) {
        return Err(error)
    }
}

/// Read the remainder of stdin as a String (UTF-8 bytes, no embedded NUL).
/// Throws on I/O error, embedded NUL, or input larger than 256 MiB.
pub fun readAllStdin(): String {
    throw "std.io readAllStdin intrinsic"
}

/// Non-throwing stdin read with an owned error payload.
pub fun readAllStdinResult(): Result<String, String> {
    try {
        return Ok(readAllStdin())
    } catch (error: String) {
        return Err(error)
    }
}

