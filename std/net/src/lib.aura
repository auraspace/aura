// std.net — bounded runtime-backed TCP transport.
//
// ForeignHandle resources keep descriptors opaque to Aura code. The compiler
// pins them only for the boundary operation and task frame that owns a wait.

package std.net

import std.error as NetErrs

/// Bind a nonblocking TCP listener. A numeric endpoint such as `"8080"`
/// defaults to loopback; use `"0.0.0.0:8080"` to expose all IPv4 interfaces.
/// The returned owned handle closes when it leaves scope.
/// A later async `accept` API will consume this listener without blocking a
/// scheduler worker.
pub fun listen(endpoint: String): ForeignHandle<Int> {
  throw "listen intrinsic"
}

/// Connect to an endpoint such as `"127.0.0.1:8080"` within `timeoutMs`.
/// The returned stream is an owned resource and may be used by async I/O.
pub fun connect(endpoint: String, timeoutMs: Int): ForeignHandle<Int> {
  throw "connect intrinsic"
}

/// Typed replacement for `listen`; recoverable bind failures are returned as
/// `NetError` instead of escaping through a thrown string.
pub fun listenResult(endpoint: String): NetErrs.Outcome<ForeignHandle<Int>, NetErrs.NetError> {
  try {
    return NetErrs.success(listen(endpoint))
  } catch (error: String) {
    return NetErrs.failure(NetErrs.asNetError(NetErrs.transport(error, 0)))
  }
}

/// Typed replacement for `connect`; recoverable connection failures are
/// returned as `NetError` instead of escaping through a thrown string.
pub fun connectResult(endpoint: String, timeoutMs: Int): NetErrs.Outcome<ForeignHandle<Int>, NetErrs.NetError> {
  try {
    return NetErrs.success(connect(endpoint, timeoutMs))
  } catch (error: String) {
    return NetErrs.failure(NetErrs.asNetError(NetErrs.transport(error, 0)))
  }
}

/// Suspend until an incoming stream is available on `listener`. The returned
/// stream is owned by the task result and remains valid across `await`.
pub async fun accept(listener: ForeignHandle<Int>): ForeignHandle<Int> {
  throw "accept intrinsic"
}

/// Close a listener. The operation is idempotent; a valid listener reports
/// `true` whether it was just closed or had already reached a terminal state.
pub fun closeListener(listener: ForeignHandle<Int>): Bool {
  throw "closeListener intrinsic"
}

/// Close a stream. Pending reads and writes observe the terminal state after
/// the scheduler removes their readiness registration.
pub fun closeStream(stream: ForeignHandle<Int>): Bool {
  throw "closeStream intrinsic"
}

/// Typed replacement for `closeListener`.
pub fun closeListenerResult(listener: ForeignHandle<Int>): NetErrs.Outcome<Bool, NetErrs.NetError> {
  try {
    return NetErrs.success(closeListener(listener))
  } catch (error: String) {
    return NetErrs.failure(NetErrs.asNetError(NetErrs.transport(error, 0)))
  }
}

/// Typed replacement for `closeStream`.
pub fun closeStreamResult(stream: ForeignHandle<Int>): NetErrs.Outcome<Bool, NetErrs.NetError> {
  try {
    return NetErrs.success(closeStream(stream))
  } catch (error: String) {
    return NetErrs.failure(NetErrs.asNetError(NetErrs.transport(error, 0)))
  }
}

/// Read up to `capacity` bytes from a typed TCP stream and suspend until it
/// is readable. EOF returns an empty String.
pub async fun readStream(stream: ForeignHandle<Int>, capacity: Int): String {
  throw "std.net readStream intrinsic"
}

/// Read until EOF or `capacity` bytes have been accumulated. This is bounded
/// and suitable for small request/response messages; streaming consumers must
/// use `readStream` so one peer cannot force an unbounded allocation.
pub async fun readAllStream(stream: ForeignHandle<Int>, capacity: Int): String {
  if (capacity <= 0) {
    return ""
  }
  var content = ""
  var remaining = capacity
  while (remaining > 0) {
    val chunk: String = await readStream(stream, remaining)
    if (chunk.isEmpty()) {
      return content
    }
    content = content + chunk
    remaining = capacity - content.len
  }
  return content
}

/// Write all content to a typed TCP stream and return the transferred byte
/// count. The input is copied into the task frame before the first await.
pub async fun writeStream(stream: ForeignHandle<Int>, content: String): Int {
  throw "std.net writeStream intrinsic"
}

/// Non-throwing read wrapper. `OutcomeOk` contains the owned chunk (or the
/// empty string at EOF); transport failures are classified as network errors.
pub async fun readStreamResult(stream: ForeignHandle<Int>, capacity: Int): NetErrs.Outcome<String, NetErrs.NetError> {
  try {
    val chunk: String = await readStream(stream, capacity)
    return NetErrs.success(chunk)
  } catch (error: String) {
    return NetErrs.failure(NetErrs.asNetError(NetErrs.transport(error, 0)))
  }
}

/// Non-throwing write wrapper. The success value is the number of bytes sent;
/// transport failures are classified as network errors.
pub async fun writeStreamResult(stream: ForeignHandle<Int>, content: String): NetErrs.Outcome<Int, NetErrs.NetError> {
  try {
    val transferred: Int = await writeStream(stream, content)
    return NetErrs.success(transferred)
  } catch (error: String) {
    return NetErrs.failure(NetErrs.asNetError(NetErrs.transport(error, 0)))
  }
}
